[Unit]
Description=Xiaomi Sheng NT36532E userspace touch processor
After=systemd-modules-load.service bluetooth.service
Wants=bluetooth.service
ConditionPathExists=/proc/nvt_thp_stream
ConditionPathExists=/proc/nvt_thp_stylus

[Service]
Type=simple
ExecStart=/usr/libexec/xiaomi-sheng-thp/xiaomi-sheng-thp
Restart=on-failure
RestartSec=1
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

